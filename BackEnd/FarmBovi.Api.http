@baseUrl = http://localhost:5080

### Health
GET {{baseUrl}}/health

### Consultar colecciones
GET {{baseUrl}}/api/animales
GET {{baseUrl}}/api/lotes
GET {{baseUrl}}/api/ranchos
GET {{baseUrl}}/api/usuarios
GET {{baseUrl}}/api/usuario-ranchos
GET {{baseUrl}}/api/eventos-sanitarios
GET {{baseUrl}}/api/tratamientos
GET {{baseUrl}}/api/recordatorios

### Crear rancho
POST {{baseUrl}}/api/ranchos
Content-Type: application/json

{
  "nombre": "Rancho Norte",
  "ubicacionGeneral": "Sonora",
  "estado": "Activo",
  "idAutor": 1
}

### Crear usuario (la respuesta nunca incluye Contrasena)
POST {{baseUrl}}/api/usuarios
Content-Type: application/json

{
  "nombre": "Ana",
  "correo": "ana@example.com",
  "contrasena": "CambiaEstaClave123",
  "estado": "Activo"
}

### Crear evento sanitario (Módulo 3: Sanidad y Agenda)
POST {{baseUrl}}/api/eventos-sanitarios
Content-Type: application/json

{
  "idAnimal": 1,
  "tipo": "Vacunación",
  "fecha": "2026-11-12T10:00:00Z",
  "sintomas": "Ninguno",
  "diagnostico": "Esquema preventivo anual",
  "profesionalDiagnostico": "MVZ Roberto Gómez",
  "responsable": "Juan Pérez",
  "observaciones": "Lote vacuna clostridial",
  "idAutor": 1
}

### Crear tratamiento (Módulo 3: Sanidad y Agenda)
POST {{baseUrl}}/api/tratamientos
Content-Type: application/json

{
  "idEventoSanitario": 1,
  "producto": "Bacterina Triple",
  "dosis": 5.000,
  "unidadDosis": "ml",
  "viaAdministracion": "Subcutánea",
  "frecuencia": "Dosis única",
  "fechaInicio": "2026-11-12T10:00:00Z",
  "responsable": "Juan Pérez",
  "estado": "Completado",
  "idAutor": 1
}

### Crear recordatorio (Módulo 3: Sanidad y Agenda)
POST {{baseUrl}}/api/recordatorios
Content-Type: application/json

{
  "idRancho": 1,
  "idAnimal": 1,
  "idTratamiento": 1,
  "idResponsable": 1,
  "tipo": "Refuerzo",
  "descripcion": "Aplicar segunda dosis de refuerzo",
  "fechaProgramada": "2026-11-26T09:00:00Z",
  "estado": "Pendiente",
  "idAutor": 1
}

### Sincronización: Enviar operación CREATE (Módulo 7: Sincronización y Auditoría)
POST {{baseUrl}}/api/sync/operaciones
Content-Type: application/json

{
  "idOperacion": "op-20261113-0001",
  "idRancho": 1,
  "idUsuario": 1,
  "idDispositivo": "movil-capataz-01",
  "entidad": "Animal",
  "accion": "CREATE",
  "datos": {
    "idRancho": 1,
    "idLote": 1,
    "arete": "MX-SYNC-100",
    "nombre": "Relámpago",
    "sexo": "Macho",
    "raza": "Brahman",
    "estado": "Activo"
  }
}

### Sincronización: Enviar operación UPDATE con validación de versión
POST {{baseUrl}}/api/sync/operaciones
Content-Type: application/json

{
  "idOperacion": "op-20261113-0002",
  "idRancho": 1,
  "idUsuario": 1,
  "idDispositivo": "movil-capataz-01",
  "entidad": "Animal",
  "idRegistro": "1",
  "accion": "UPDATE",
  "versionBase": 1,
  "datos": {
    "idRancho": 1,
    "idLote": 1,
    "arete": "MX-SYNC-100",
    "nombre": "Relámpago II",
    "sexo": "Macho",
    "raza": "Brahman Rojo",
    "estado": "Activo"
  }
}

### Sincronización: Consultar cambios remotos y auditoría
GET {{baseUrl}}/api/sync/cambios?idRancho=1&desdeId=0
GET {{baseUrl}}/api/sync/auditoria?idRancho=1&entidad=Animal
