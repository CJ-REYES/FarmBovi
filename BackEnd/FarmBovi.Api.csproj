<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <OutputPath>bin\CustomBuild\</OutputPath>
  </PropertyGroup>
  <Target Name="SignMyAssembly" AfterTargets="Build">
    <Exec Command="powershell -Command &quot;&amp; { $cert = Get-ChildItem Cert:\CurrentUser\My | Where-Object { $_.Subject -like '*FarmBoviLocalCert*' } | Select-Object -First 1; Set-AuthenticodeSignature -FilePath '$(OutputPath)FarmBovi.Api.dll' -Certificate $cert }&quot;" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>
</Project>