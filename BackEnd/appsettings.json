{
  "ConnectionStrings": {
    "FarmBovi": "Server=localhost;Port=3306;Database=farmbovi;User ID=CHANGE_ME_DB_USER;Password=CHANGE_ME_DB_PASSWORD;"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "MediaStorage": {
    "Provider": "LocalFileSystem",
    "PrivateRootPath": "App_Data/media",
    "MaxFileSizeBytes": 10485760
  },
  "BoviScale": {
    "BaseUrl": "",
    "AnalyzeEndpoint": "/api/v1/estimate-weight",
    "ApiKeyHeaderName": "X-Api-Key",
    "ApiKey": "",
    "TimeoutSeconds": 25,
    "MinValidWeightKg": 15,
    "MaxValidWeightKg": 2000,
    "AllowedWeightUnit": "kg",
    "ImageTransportFormat": "base64"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
